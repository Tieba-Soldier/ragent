POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_PASSWORD=replace-with-a-random-password
RUSTFS_ACCESS_KEY=replace-with-a-random-access-key
RUSTFS_SECRET_KEY=replace-with-a-random-secret-key

# Add at least one provider key before testing real AI conversations.
BAILIAN_API_KEY=
AIHUBMIX_API_KEY=
SILICONFLOW_API_KEY=
MINERU_API_KEY=

# workflow works without the optional Agent UI. Switch to agent after configuring SILICONFLOW_API_KEY.
RAGENT_ENGINE_TYPE=workflow
RAG_RERANK_ENABLED=false
