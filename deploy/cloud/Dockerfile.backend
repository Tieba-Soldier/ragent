FROM maven:3.9.11-eclipse-temurin-17 AS build
WORKDIR /workspace
ENV MAVEN_OPTS="-Xms128m -Xmx1024m -XX:+UseG1GC"
COPY deploy/cloud/maven-settings.xml /root/.m2/settings.xml
COPY . .
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -DskipTests -Dspotless.check.skip=true package

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /workspace/bootstrap/target/*.jar /app/ragent.jar
EXPOSE 9081
ENTRYPOINT ["java", "-jar", "/app/ragent.jar"]
